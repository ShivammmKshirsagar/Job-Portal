# ==========================================
# CareerConnect Global Environment Template
# ==========================================

# Application Port & Environment
PORT=5000
NODE_ENV=production

# Client Application URL (For CORS & Sockets)
CLIENT_URL=http://localhost

# Database Connection (Local or Docker)
# Use 'mongodb://mongodb:27017/careerconnect_db' inside Docker Compose
# Use 'mongodb://127.0.0.1:27017/careerconnect_db' for native local development
MONGODB_URI=mongodb://mongodb:27017/careerconnect_db

# JWT Authentication Configuration (MANDATORY)
# Provide a secure random secret key (minimum 32 characters required).
# Docker Compose interpolates this variable into backend container configuration.
# Do not commit real secrets to version control.
# Generate a cryptographically strong secret for each environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or
#   openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Optional SMTP Email Configuration (Development uses dev tokens)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@careerconnect.com
