# Backend API Base URL (leave empty in local dev to use Vite proxy at /api)
# Production example: https://careerconnect-backend-o5so.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com

# Socket.IO Server URL (leave empty in local dev to use Vite proxy)
# Production example: https://careerconnect-backend-o5so.onrender.com
VITE_SOCKET_URL=https://your-backend-service.onrender.com

