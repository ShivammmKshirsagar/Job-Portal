{
  "name": "careerconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CareerConnect - Comprehensive Full-Stack Job Portal",
  "type": "module",
  "scripts": {
    "start": "npm --prefix server start",
    "dev": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "seed": "npm --prefix server run seed",
    "seed:india": "npm --prefix server run seed:india",
    "test": "npm --prefix server test",
    "test:india": "npm --prefix server run test:india",
    "test:dashboard": "npm --prefix server run test:dashboard",
    "test:audit": "npm --prefix server run test:audit",
    "screenshots": "node scripts/capture-screenshots.js && node scripts/capture-docker-screenshot.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
